        // 加载数据（优先从线上同步，其次本地缓存，最后默认）
        function loadData() {
            // 先用本地/默认数据快速渲染，避免页面空白
            loadLocalData();
            // 再从线上同步数据（异步）
            fetch('/api/nav?key=navData')
                .then(r => r.json())
                .then(data => {
                    if (data && data.data && Array.isArray(data.data) && data.data.length > 0) {
                        navData = data.data;
                        try { localStorage.setItem('myNavData_v2', JSON.stringify(navData)); } catch(e) {}
                        renderAccordion();
                    }
                })
                .catch(() => {});
        }

        function loadLocalData() {
            try {
                const saved = localStorage.getItem('myNavData_v2');
                if (saved) {
                    navData = JSON.parse(saved);
                } else {
                    navData = JSON.parse(JSON.stringify(defaultData));
                }
            } catch(e) {
                navData = JSON.parse(JSON.stringify(defaultData));
            }
            
            // 自动迁移：把最后一个分类"更多分类"改成"系统工具"并加密
            let needSave = false;
            navData.forEach((cat, idx) => {
                // 如果是旧分类名，改名并加密
                if (cat.name === '更多分类' || cat.name === '其他') {
                    cat.name = '系统工具';
                    cat.icon = '🔧';
                    cat.password = '123456';
                    needSave = true;
                }
                // 系统工具分类密码锁：第一次打开时默认123456，用户修改后就保留用户的密码
                if (cat.name === '系统工具') {
                    if (!cat.password) {
                        cat.password = '123456';
                        needSave = true;
                    }
                    // 同时把入口链接改成新域名
                    if (cat.sites && cat.sites.length > 0) {
                        cat.sites[0].url = 'https://zhouyu86.de5.net/TVBox%E6%BA%90%E5%9C%B0%E5%9D%80%E5%A4%A7%E5%85%A8.html';
                        cat.sites[1].url = 'https://zhouyu86.de5.net/TVBox%E6%8E%A5%E5%8F%A3%E7%BC%96%E8%BE%91%E5%99%A8.html';
                    }
                }
                // 自动升级：如果系统工具分类里是旧的33个复制型网站，替换成新的入口
                if (cat.name === '系统工具' && cat.sites && cat.sites.length > 1) {
                    const firstSite = cat.sites[0];
                    if (firstSite.type === 'copy' || (firstSite.name && (firstSite.name.includes('本地') || firstSite.name.includes('在线')))) {
                        cat.sites = [
                            { name: '📺 TVBox源地址大全（一键复制）', icon: '📺', url: 'https://zhouyu365666.top/TVBox%E6%BA%90%E5%9C%B0%E5%9D%80%E5%A4%A7%E5%85%A8.html', type: 'link' },
                            { name: '📝 TVBox接口编辑器（可修改）', icon: '📝', url: 'https://zhouyu365666.top/TVBox%E6%8E%A5%E5%8F%A3%E7%BC%96%E8%BE%91%E5%99%A8.html', type: 'link' }
                        ];
                        needSave = true;
                    }
                }
                // 自动修复：如果系统工具分类里的链接是相对路径，改成完整URL
                if (cat.name === '系统工具' && cat.sites) {
                    cat.sites.forEach(site => {
                        if (site.url && !site.url.startsWith('http')) {
                            if (site.name && site.name.includes('源地址大全')) {
                                site.url = 'https://zhouyu365666.top/TVBox%E6%BA%90%E5%9C%B0%E5%9D%80%E5%A4%A7%E5%85%A8.html';
                                needSave = true;
                            } else if (site.name && site.name.includes('接口编辑器')) {
                                site.url = 'https://zhouyu365666.top/TVBox%E6%8E%A5%E5%8F%A3%E7%BC%96%E8%BE%91%E5%99%A8.html';
                                needSave = true;
                            }
                        }
                    });
                    // 自动添加缺少的网站
                    const hasEditor = cat.sites.some(s => s.name && s.name.includes('接口编辑器'));
                    const hasStation = cat.sites.some(s => s.name && s.name.includes('接口站'));
                    const has18 = cat.sites.some(s => s.name && (s.name.includes('合并配置18') || s.name.includes('配置18')));
                    if (!hasEditor) {
                        cat.sites.push({ name: '📝 TVBox接口编辑器（可修改）', icon: '📝', url: 'https://zhouyu365666.top/TVBox%E6%8E%A5%E5%8F%A3%E7%BC%96%E8%BE%91%E5%99%A8.html', type: 'link' });
                        needSave = true;
                    }
                    if (!hasStation) {
                        cat.sites.push({ name: '📡 TVBox接口站（Cloudflare）', icon: '📡', url: 'https://zhouyu365666.top', type: 'link' });
                        needSave = true;
                    }
                    if (!has18) {
                        cat.sites.push({ name: '🔞 合并配置18（域名）', icon: '🔞', url: 'https://zhouyu365666.top/assets/static/data/tvbox18.json', type: 'link' });
                        needSave = true;
                    }
                }
            });
            if (needSave) saveData();
            // 自动迁移灰色图标为彩色图标
            const grayToColor = {
                '⚡': '🌩️', '📄': '📝', '❓': '🤔', '📋': '📝',
